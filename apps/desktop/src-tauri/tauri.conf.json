{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "App Buttons Remap",
  "version": "0.1.0",
  "identifier": "org.appbuttons.remap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "App Buttons Remap",
        "width": 960,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png"
    ],
    "targets": [
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "Perfis de mouse para aplicativos no KDE Wayland",
    "linux": {
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "systemd",
          "systemd-libs",
          "kwin"
        ],
        "files": {
          "/usr/libexec/bindforge/remap-daemon": "../../../target/release/remap-daemon",
          "/usr/lib/systemd/user/bindforge-daemon.service": "../../../integrations/systemd/bindforge-daemon.service"
        }
      }
    }
  }
}
