{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BindForge",
  "version": "0.1.0",
  "identifier": "org.bindforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BindForge",
        "width": 960,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png"
    ],
    "targets": [
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "Perfis de mouse para aplicativos no KDE Wayland",
    "linux": {
      "rpm": {
        "release": "2",
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3",
          "systemd",
          "systemd-libs",
          "kwin",
          "polkit",
          "kmod"
        ],
        "files": {
          "/usr/libexec/bindforge/bindforge-daemon": "../../../target/release/bindforge-daemon",
          "/usr/lib/systemd/user/bindforge-daemon.service": "../../../integrations/systemd/bindforge-daemon.service",
          "/usr/libexec/bindforge/bindforge-device-access": "../../../target/release/bindforge-device-access",
          "/usr/share/polkit-1/actions/org.bindforge.device-access.policy": "../../../integrations/polkit/org.bindforge.device-access.policy"
        },
        "obsoletes": [
          "app-buttons-remap <= 0.1.0"
        ]
      }
    }
  }
}
